<Window
    x:Class="Astra.App.Overlays.CursorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Width="72" Height="72">
        <Ellipse x:Name="Pulse" Stroke="White" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Spinner" Stroke="White" StrokeThickness="2.5" StrokeDashArray="1.6 2.2" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><RotateTransform x:Name="SpinRotate" /></Ellipse.RenderTransform>
        </Ellipse>
        <Grid x:Name="IconHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0">
            <Ellipse x:Name="Dot1" Width="5" Height="5" />
            <Ellipse x:Name="Dot2" Width="5" Height="5" />
            <Ellipse x:Name="Dot3" Width="5" Height="5" />
        </StackPanel>
        <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0">
            <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
            <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
            <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
            <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" />
        </StackPanel>
        <FontIcon x:Name="ErrorMark" Glyph="&#xE711;" FontSize="14" Foreground="#FFFF5C5C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0" />
    </Grid>
</Window>

<Window
    x:Class="Astra.App.Overlays.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="12">
        <Border x:Name="Card" Padding="16,14,16,14" MinHeight="64">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="IconHost" Width="30" Height="30" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="NameText" Text="Astra" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="PhaseText" FontSize="12" />
                    </StackPanel>
                    <StackPanel x:Name="LevelBars" Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="TaskText" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <StackPanel x:Name="StepList" Spacing="5" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window
    x:Class="Astra.App.Overlays.BubbleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="12">
        <Border x:Name="Card" Padding="16,12,16,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconHost" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock x:Name="BubbleText" Grid.Column="1" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Page
    x:Class="Astra.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Astra.App.Controls">
    <Grid Padding="36,4,36,24" RowSpacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status header -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="OrbHost" Width="48" Height="48" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="MicMeter" Width="90" Height="4" Maximum="1" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ListenBtn" Click="Listen_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE720;" FontSize="14" />
                        <TextBlock x:Name="ListenLabel" Text="Listening" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Setup banners -->
        <StackPanel x:Name="Banners" Grid.Row="1" Spacing="6" />

        <!-- Conversation -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel x:Name="Messages" Spacing="10" VerticalAlignment="Bottom" />
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="560">
                <TextBlock x:Name="HintText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="Examples">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Input -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" PlaceholderText="Type a command…" MinHeight="40" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
            <Button x:Name="MicBtn" Grid.Column="1" Width="44" Height="40" ToolTipService.ToolTip="Hold to talk">
                <FontIcon Glyph="&#xE720;" />
            </Button>
            <Button x:Name="SendBtn" Grid.Column="2" Width="44" Height="40" Style="{StaticResource AccentButtonStyle}" Click="Send_Click">
                <FontIcon x:Name="SendIcon" Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</Page>

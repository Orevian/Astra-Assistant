<Page
    x:Class="Astra.App.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Astra.App.Controls">
    <ScrollViewer>
        <StackPanel Spacing="4" Padding="36,4,36,36" MaxWidth="940" HorizontalAlignment="Stretch">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Themes, icon and the on-screen presence of Astra. Every element works independently." Style="{StaticResource PageSubtitleStyle}" />

            <!-- Live preview -->
            <Border x:Name="PreviewStage" CornerRadius="8" Height="150" Margin="0,0,0,4" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B2030" Offset="0" />
                        <GradientStop Color="#3A2E63" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border x:Name="HudPreview" Width="270" Padding="14,12" CornerRadius="10"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        Background="#CC12141C" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid x:Name="PreviewIcon" Width="22" Height="22" />
                            <TextBlock Text="Astra" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Opening Avast Secure Browser…" Foreground="#DDFFFFFF" FontSize="12" />
                        <ProgressBar x:Name="PreviewBar" Value="62" Maximum="100" />
                    </StackPanel>
                </Border>
            </Border>

            <TextBlock Text="Theme" Style="{StaticResource GroupTitleStyle}" />
            <GridView x:Name="ThemeGrid" SelectionMode="Single" IsItemClickEnabled="False" Margin="0,2,0,0" />
            <ctl:SettingsCard Header="App color mode" Description="Light, dark or follow Windows." Glyph="&#xE790;">
                <ComboBox x:Name="ModeBox" Width="200" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Accent color" Description="Used for toggles, buttons and Astra’s overlays." Glyph="&#xE790;">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="AccentLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="AccentBtn" Width="44" Height="32" Padding="0" CornerRadius="6">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsHexInputVisible="True" ColorSpectrumShape="Ring" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ctl:SettingsCard>

            <TextBlock Text="Icon" Style="{StaticResource GroupTitleStyle}" />
            <GridView x:Name="IconGrid" SelectionMode="Single" IsItemClickEnabled="False" Margin="0,2,0,0" />
            <ctl:SettingsCard Header="Custom icon" x:Name="CustomIconCard" Description="Use your own PNG or SVG. It replaces the built-in icon in the app, HUD, cursor and tray." Glyph="&#xE91B;">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Choose file…" Click="ChooseIcon_Click" />
                    <Button x:Name="ClearIconBtn" Content="Clear" Click="ClearIcon_Click" />
                </StackPanel>
            </ctl:SettingsCard>

            <TextBlock Text="Overlays" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Preview overlays" Description="Shows the HUD, AI cursor, notification, speech bubble and visualizer with sample content." Glyph="&#xE768;">
                <Button Content="Preview" Click="Preview_Click" Style="{StaticResource AccentButtonStyle}" />
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="HUD" Description="Shows listening, thinking and each step Astra is executing." Glyph="&#xE9D2;">
                <ToggleSwitch x:Name="HudToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="HudDisplayCard" Header="HUD display" Description="Which screen the HUD, speech bubble, visualizer and permission prompts appear on. Default is the primary display." Glyph="&#xE7F4;">
                <ComboBox x:Name="HudDisplayBox" Width="300" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="HudPosCard" Header="HUD position" Glyph="&#xE7F4;">
                <ComboBox x:Name="HudPosBox" Width="200" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="HudOpacityCard" Header="HUD opacity" Glyph="&#xE7B3;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="HudOpacity" Width="200" Minimum="30" Maximum="100" />
                    <TextBlock x:Name="HudOpacityLabel" Width="44" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="AI cursor" Description="A visual cursor that shows where Astra is acting: idle, listening, thinking, executing, speaking, error." Glyph="&#xE7C9;">
                <ToggleSwitch x:Name="CursorToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="CursorSizeCard" Header="Cursor size" Glyph="&#xE8A3;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="CursorSize" Width="200" Minimum="16" Maximum="64" />
                    <TextBlock x:Name="CursorSizeLabel" Width="44" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Speech bubble" Description="Shows what Astra says in a bubble on screen. Off by default." Glyph="&#xE8BD;">
                <ToggleSwitch x:Name="BubbleToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="BubblePosCard" Header="Bubble position" Glyph="&#xE7F4;">
                <ComboBox x:Name="BubblePosBox" Width="200" />
            </ctl:SettingsCard>

            <ctl:SettingsCard Header="Audio visualizer" Description="Spectrum that moves with Astra’s voice in real time. Off by default; sits at the top right of the screen." Glyph="&#xE8D6;">
                <ToggleSwitch x:Name="VizToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="VizStyleCard" Header="Visualizer style" Glyph="&#xE9D9;">
                <ComboBox x:Name="VizStyleBox" Width="200" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="VizPosCard" Header="Visualizer position" Glyph="&#xE7F4;">
                <ComboBox x:Name="VizPosBox" Width="200" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="VizSizeCard" Header="Visualizer size" Glyph="&#xE8A3;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="VizSize" Width="200" Minimum="50" Maximum="200" />
                    <TextBlock x:Name="VizSizeLabel" Width="44" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="VizOpacityCard" Header="Visualizer opacity" Glyph="&#xE7B3;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="VizOpacity" Width="200" Minimum="20" Maximum="100" />
                    <TextBlock x:Name="VizOpacityLabel" Width="44" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SettingsCard>

            <TextBlock Text="Notifications" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Notifications" Description="Astra’s own pop-ups when a task completes or fails." Glyph="&#xEA8F;">
                <ToggleSwitch x:Name="NotifToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="NotifDisplayCard" Header="Notification display" Description="Which screen notifications appear on. Default is the primary display." Glyph="&#xE7F4;">
                <ComboBox x:Name="NotifDisplayBox" Width="300" />
            </ctl:SettingsCard>
            <ctl:SettingsCard x:Name="NotifPosCard" Header="Notification position" Glyph="&#xE7F4;">
                <ComboBox x:Name="NotifPosBox" Width="200" />
            </ctl:SettingsCard>

            <TextBlock Text="Behavior" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Animations" Description="Turn off for a static interface and lower CPU use." Glyph="&#xE916;">
                <ToggleSwitch x:Name="AnimToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>

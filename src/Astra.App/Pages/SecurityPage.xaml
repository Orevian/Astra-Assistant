<Page
    x:Class="Astra.App.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Astra.App.Controls">
    <ScrollViewer>
        <StackPanel Spacing="4" Padding="36,4,36,36" MaxWidth="940" HorizontalAlignment="Stretch">
            <TextBlock Text="Security" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Decide what Astra may do on its own and what needs your approval." Style="{StaticResource PageSubtitleStyle}" />

            <TextBlock Text="Permissions" Style="{StaticResource GroupTitleStyle}" />
            <StackPanel x:Name="PermissionList" Spacing="4" />

            <TextBlock Text="Confirmation rules" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Always confirm destructive actions" Description="Deleting, overwriting or other irreversible actions always ask first, whatever the category setting." Glyph="&#xE7BA;">
                <ToggleSwitch x:Name="DestructiveToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Confirm deleting this many files or more" Description="Bulk operations at or above this count show the exact number before running." Glyph="&#xE74D;">
                <NumberBox x:Name="BulkBox" Width="120" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Inline" />
            </ctl:SettingsCard>

            <TextBlock Text="Stored credentials" Style="{StaticResource GroupTitleStyle}" />
            <StackPanel x:Name="CredentialList" Spacing="4" />
        </StackPanel>
    </ScrollViewer>
</Page>

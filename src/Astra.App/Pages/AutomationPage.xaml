<Page
    x:Class="Astra.App.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Astra.App.Controls">
    <ScrollViewer>
        <StackPanel Spacing="4" Padding="36,4,36,36" MaxWidth="940" HorizontalAlignment="Stretch">
            <TextBlock Text="Automation" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="How Astra controls apps, the browser, mouse and keyboard." Style="{StaticResource PageSubtitleStyle}" />

            <TextBlock Text="Browser" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard x:Name="BrowserCard" Header="Preferred browser" Glyph="&#xE774;"
                              Description="Used when you don’t name a browser. Detected from Windows.">
                <ComboBox x:Name="BrowserBox" Width="280" />
            </ctl:SettingsCard>

            <TextBlock Text="Control" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Prefer UI Automation" Description="Target buttons and fields through Windows accessibility info instead of screen coordinates. More reliable." Glyph="&#xE7C3;">
                <ToggleSwitch x:Name="UiaToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Allow mouse control" Glyph="&#xE962;">
                <ToggleSwitch x:Name="MouseToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Allow keyboard control" Glyph="&#xE765;">
                <ToggleSwitch x:Name="KeyboardToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Verify every action" Description="Check the result after each step and try another method if it failed." Glyph="&#xE73E;">
                <ToggleSwitch x:Name="VerifyToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Delay between actions" Description="Increase for slower PCs or apps that load gradually." Glyph="&#xE916;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="DelaySlider" Width="200" Minimum="0" Maximum="1000" StepFrequency="25" />
                    <TextBlock x:Name="DelayLabel" Width="60" VerticalAlignment="Center" />
                </StackPanel>
            </ctl:SettingsCard>

            <TextBlock Text="Agent" Style="{StaticResource GroupTitleStyle}" />
            <ctl:SettingsCard Header="Local-first intents" Description="Resolve simple commands like “open Chrome” on this PC without calling the AI model. Saves tokens and time." Glyph="&#xE945;">
                <ToggleSwitch x:Name="LocalToggle" OnContent="" OffContent="" MinWidth="0" />
            </ctl:SettingsCard>
            <ctl:SettingsCard Header="Maximum steps per task" Description="Astra stops and asks you if a task needs more steps than this." Glyph="&#xE9D9;">
                <NumberBox x:Name="StepsBox" Width="120" Minimum="3" Maximum="100" SpinButtonPlacementMode="Inline" />
            </ctl:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
